# Supabase — anon key is read-only (RLS SELECT-only, see supabase/schema.sql); every write goes
# through Next.js API routes using the service-role key, which bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Groq gpt-oss-120b — reading messy files, structuring typed text, drafting/translating short
# visitor copy, one-line "Why?" explanations. Never numbers, never approvals (see CLAUDE.md).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
